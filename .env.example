# ==========================================
# MS Velora — Environment Variables
# Copy this file to .env for local development
# Add these variables in Vercel Dashboard -> Settings -> Environment Variables
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-domain.vercel.app

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/msvelora?retryWrites=true&w=majority

# Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_string
JWT_EXPIRES_IN=7d
COOKIE_SECURE=true

# Media Uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Payments (Cash on Delivery / Easypaisa / JazzCash / Stripe)
PAYMENT_PROVIDER=cod
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Seed Administrator Account
ADMIN_EMAIL=admin@msvelora.com
ADMIN_PASSWORD=change_this_secure_password_123!

# AI Assistant (Google Gemini) - Optional
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Web Push Notifications (VAPID) - Optional
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@msvelora.com
