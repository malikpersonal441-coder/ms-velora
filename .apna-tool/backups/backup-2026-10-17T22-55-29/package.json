{
  "name": "msvelora",
  "version": "1.0.0",
  "private": true,
  "description": "MS Velora — Women's Jewellery E-Commerce Platform with Full-Stack Serverless Backend & Admin Dashboard",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "tsx watch server/server.ts",
    "dev:frontend": "vite",
    "build:server": "tsc -p tsconfig.server.json",
    "build:frontend": "vite build",
    "build": "tsc -p tsconfig.server.json && vite build",
    "seed": "tsx server/seed/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "framer-motion": "^12.4.7",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "mongoose": "^8.10.1",
    "multer": "^1.4.5-lts.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.4",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.6"
  },
  "keywords": [
    "msvelora",
    "jewellery",
    "ecommerce",
    "react",
    "typescript",
    "express",
    "mongodb",
    "tailwindcss",
